# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — option A: individual variables (password may contain special chars)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Database — option B: full URL (@ in password must be encoded as %40)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (Sprint 2 — paths only)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS (placeholders — Sprint 4+)
AWS_REGION=ap-south-1
S3_BUCKET=hms-dev-files
SQS_QUEUE_URL=
SES_FROM_EMAIL=noreply@platform.com

# Razorpay (Sprint 11 — placeholders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
