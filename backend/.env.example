# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — option A: individual variables (password may contain special chars)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=Rohit@prabha

# Database — option B: full URL (@ in password must be encoded as %40)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (RS256 — run: python scripts/generate_jwt_keys.py)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=https://auth.platform.com
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
TENANT_BASE_DOMAIN=platform.com
AUTH_RATE_LIMIT_PER_MINUTE=10

# Startup validation (set true to skip DB/Redis checks on boot — faster local dev)
SKIP_STARTUP_CHECKS=false

# AWS (placeholders — Sprint 4+)
AWS_REGION=ap-south-1
S3_BUCKET=hms-dev-files
SQS_QUEUE_URL=
SES_FROM_EMAIL=noreply@platform.com

# Razorpay (Sprint 11 — placeholders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
